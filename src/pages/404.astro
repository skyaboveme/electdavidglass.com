---
import Base from '../layouts/Base.astro';
---

<Base title="Page Not Found" description="The page you're looking for doesn't exist. Return to the David Glass for Bastrop County Commissioner website.">
  <section class="min-h-[70vh] flex items-center justify-center bg-cream py-20 px-4">
    <div class="text-center max-w-xl mx-auto">
      
      <!-- Large 404 display -->
      <div class="relative mb-8">
        <span class="text-[10rem] sm:text-[14rem] font-montserrat-black text-navy/5 leading-none select-none block">
          404
        </span>
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="w-20 h-1 bg-gold rounded-full"></div>
        </div>
      </div>

      <h1 class="text-3xl sm:text-4xl font-serif text-navy mb-4">
        Page Not Found
      </h1>
      <p class="text-slate text-lg mb-10 max-w-md mx-auto">
        Sorry, the page you're looking for doesn't exist or has been moved. Let's get you back on track.
      </p>

      <!-- Navigation links -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/" class="inline-flex items-center gap-2 bg-navy text-white font-semibold px-8 py-3.5 rounded-lg hover:bg-navy-light transition-colors duration-200">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1" />
          </svg>
          Back to Home
        </a>
        <a href="/priorities" class="inline-flex items-center gap-2 border-2 border-navy text-navy font-semibold px-8 py-3.5 rounded-lg hover:bg-navy hover:text-white transition-colors duration-200">
          View Priorities
        </a>
      </div>

      <!-- Helpful links -->
      <div class="mt-14 pt-8 border-t border-navy/10">
        <p class="text-sm text-slate mb-4 uppercase tracking-wider font-medium">Helpful Links</p>
        <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm">
          <a href="/about" class="text-navy hover:text-gold transition-colors duration-200">About David</a>
          <span class="text-navy/20 hidden sm:inline">|</span>
          <a href="/results" class="text-navy hover:text-gold transition-colors duration-200">Results</a>
          <span class="text-navy/20 hidden sm:inline">|</span>
          <a href="/voter-tools" class="text-navy hover:text-gold transition-colors duration-200">Voter Tools</a>
          <span class="text-navy/20 hidden sm:inline">|</span>
          <a href="/precinct-4" class="text-navy hover:text-gold transition-colors duration-200">Precinct 4</a>
        </div>
      </div>
    </div>
  </section>
</Base>
