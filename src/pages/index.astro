  <!-- Lightbox Script -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const modal = document.getElementById('endorsement-modal');
      const openBtn1 = document.getElementById('open-endorsement-modal');
      const openBtn2 = document.getElementById('open-endorsement-modal-img');
      const closeBtn = document.getElementById('close-endorsement-modal');

      function openModal() {
        if (!modal) return;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        setTimeout(() => {
          modal.classList.remove('opacity-0');
          modal.classList.add('opacity-100');
        }, 10);
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        if (!modal) return;
        modal.classList.remove('opacity-100');
        modal.classList.add('opacity-0');
        setTimeout(() => {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
          document.body.style.overflow = '';
        }, 300);
      }

      openBtn1?.addEventListener('click', openModal);
      openBtn2?.addEventListener('click', openModal);
      closeBtn?.addEventListener('click', closeModal);

      // Close when clicking backdrop
      modal?.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeModal();
        }
      });

      // Close on Escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
          closeModal();
        }
      });
    });
  </script>

