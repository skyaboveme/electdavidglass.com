---
import Base from '../layouts/Base.astro';
---

<Base title="Voting Times & Locations" description="2026 General Election voting schedule for Bastrop County, Texas. Early voting dates, hours, and all polling locations for Election Day.">
  
  <!-- Page Header -->
  <section class="page-header-gradient pt-28 pb-20 relative">
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="gold-line mx-auto mb-6"></div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-serif font-extrabold text-white mb-6">Voting Times &amp; Locations</h1>
      <p class="text-xl font-sans font-light text-white/70 leading-relaxed max-w-2xl mx-auto">
        2026 General Election — Bastrop County, Texas. Know exactly when and where to cast your vote.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row justify-center gap-4">
        <a 
          href="#early-voting" 
          class="inline-flex items-center px-6 py-3 bg-gold text-white font-sans font-bold text-sm uppercase tracking-wider rounded-lg hover:bg-gold-light hover:-translate-y-0.5 transition-all shadow-lg"
        >
          <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          Early Voting
        </a>
        <a 
          href="#election-day" 
          class="inline-flex items-center px-6 py-3 bg-white/10 text-white font-sans font-bold text-sm uppercase tracking-wider rounded-lg hover:bg-white/20 hover:-translate-y-0.5 transition-all border border-white/20"
        >
          <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          Election Day Locations
        </a>
      </div>
    </div>
  </section>

  <!-- Key Dates Countdown Strip -->
  <section class="bg-navy py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-8 text-center">
        <div class="reveal">
          <p class="text-gold font-sans font-bold text-xs uppercase tracking-widest mb-1">Early Voting Begins</p>
          <p class="text-white font-serif font-bold text-2xl">October 19, 2026</p>
        </div>
        <div class="reveal">
          <p class="text-gold font-sans font-bold text-xs uppercase tracking-widest mb-1">Early Voting Ends</p>
          <p class="text-white font-serif font-bold text-2xl">October 30, 2026</p>
        </div>
        <div class="reveal">
          <p class="text-gold font-sans font-bold text-xs uppercase tracking-widest mb-1">Election Day</p>
          <p class="text-white font-serif font-bold text-2xl">November 3, 2026</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Important Notice -->
  <section class="py-8 bg-gold/10 border-y border-gold/20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-start gap-4 reveal">
        <div class="flex-shrink-0 w-12 h-12 bg-gold/15 rounded-xl flex items-center justify-center mt-0.5">
          <svg class="w-6 h-6 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <h2 class="text-lg font-serif font-bold text-navy mb-1">Countywide Voting Centers</h2>
          <p class="text-near-black/70 font-sans leading-relaxed">
            Bastrop County uses <strong>countywide voting centers</strong> — you can vote at <strong>any</strong> location during early voting or on Election Day, regardless of your precinct. Bring a valid photo ID.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Early Voting Section -->
  <section id="early-voting" class="py-16 sm:py-24 bg-white scroll-mt-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16 reveal">
        <div class="gold-line mx-auto mb-6"></div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-navy mb-4">Early Voting Schedule</h2>
        <p class="text-xl text-slate font-sans font-light max-w-2xl mx-auto">
          October 19 – October 30, 2026
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
        
        <!-- Early Voting Hours Table -->
        <div class="reveal">
          <h3 class="text-2xl font-serif font-bold text-navy mb-6 flex items-center gap-3">
            <div class="w-10 h-10 bg-gold/10 rounded-xl flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            Dates &amp; Hours
          </h3>
          <div class="bg-cream rounded-2xl border border-warm-gray overflow-hidden">
            <table class="w-full text-left">
              <thead>
                <tr class="bg-navy text-white">
                  <th class="px-5 py-3 font-sans font-bold text-xs uppercase tracking-wider">Date</th>
                  <th class="px-5 py-3 font-sans font-bold text-xs uppercase tracking-wider text-right">Hours</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-warm-gray">
                <tr class="hover:bg-white/60 transition-colors">
                  <td class="px-5 py-3.5 font-sans text-near-black">Mon, Oct 19</td>
                  <td class="px-5 py-3.5 font-sans font-semibold text-near-black text-right">8:00 AM – 5:00 PM</td>
                </tr>
                <tr class="hover:bg-white/60 transition-colors">
                  <td class="px-5 py-3.5 font-sans text-near-black">Tue, Oct 20</td>
                  <td class="px-5 py-3.5 font-sans font-semibold text-near-black text-right">8:00 AM – 5:00 PM</td>
                </tr>
                <tr class="hover:bg-white/60 transition-colors">
                  <td class="px-5 py-3.5 font-sans text-near-black">Wed, Oct 21</td>
                  <td class="px-5 py-3.5 font-sans font-semibold text-near-black text-right">8:00 AM – 5:00 PM</td>
                </tr>
                <tr class="hover:bg-white/60 transition-colors">
                  <td class="px-5 py-3.5 font-sans text-near-black">Thu, Oct 22</td>
                  <td class="px-5 py-3.5 font-sans font-semibold text-near-black text-right">8:00 AM – 5:00 PM</td>
                </tr>
                <tr class="hover:bg-white/60 transition-colors">
                  <td class="px-5 py-3.5 font-sans text-near-black">Fri, Oct 23</td>
                  <td class="px-5 py-3.5 font-sans font-semibold text-near-black text-right">8:00 AM – 5:00 PM</td>
                </tr>
                <tr class="bg-gold/8 hover:bg-gold/15 transition-colors">
                  <td class="px-5 py-3.5 font-sans text-near-black font-semibold">
                    <span class="inline-flex items-center gap-1.5">
                      Sat, Oct 24
                      <span class="text-[10px] bg-gold/20 text-gold px-1.5 py-0.5 rounded font-bold uppercase tracking-wider">Extended</span>
                    </span>
                  </td>
                  <td class="px-5 py-3.5 font-sans font-bold text-navy text-right">7:00 AM – 7:00 PM</td>
                </tr>
                <tr class="bg-gold/8 hover:bg-gold/15 transition-colors">
                  <td class="px-5 py-3.5 font-sans text-near-black font-semibold">
                    <span class="inline-flex items-center gap-1.5">
                      Sun, Oct 25
                      <span class="text-[10px] bg-navy/10 text-navy px-1.5 py-0.5 rounded font-bold uppercase tracking-wider">Limited</span>
                    </span>
                  </td>
                  <td class="px-5 py-3.5 font-sans font-bold text-navy text-right">9:00 AM – 3:00 PM</td>
                </tr>
                <tr class="hover:bg-white/60 transition-colors">
                  <td class="px-5 py-3.5 font-sans text-near-black font-semibold">Mon, Oct 26</td>
                  <td class="px-5 py-3.5 font-sans font-bold text-navy text-right">7:00 AM – 7:00 PM</td>
                </tr>
                <tr class="hover:bg-white/60 transition-colors">
                  <td class="px-5 py-3.5 font-sans text-near-black font-semibold">Tue, Oct 27</td>
                  <td class="px-5 py-3.5 font-sans font-bold text-navy text-right">7:00 AM – 7:00 PM</td>
                </tr>
                <tr class="hover:bg-white/60 transition-colors">
                  <td class="px-5 py-3.5 font-sans text-near-black font-semibold">Wed, Oct 28</td>
                  <td class="px-5 py-3.5 font-sans font-bold text-navy text-right">7:00 AM – 7:00 PM</td>
                </tr>
                <tr class="hover:bg-white/60 transition-colors">
                  <td class="px-5 py-3.5 font-sans text-near-black font-semibold">Thu, Oct 29</td>
                  <td class="px-5 py-3.5 font-sans font-bold text-navy text-right">7:00 AM – 7:00 PM</td>
                </tr>
                <tr class="hover:bg-white/60 transition-colors">
                  <td class="px-5 py-3.5 font-sans text-near-black font-semibold">Fri, Oct 30</td>
                  <td class="px-5 py-3.5 font-sans font-bold text-navy text-right">7:00 AM – 7:00 PM</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="mt-4 text-sm text-near-black/50 font-sans flex items-center gap-2">
            <svg class="w-4 h-4 text-gold flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Week 2 (Oct 24–30) has extended hours for your convenience.
          </p>
        </div>

        <!-- Early Voting Locations -->
        <div class="reveal-right">
          <h3 class="text-2xl font-serif font-bold text-navy mb-6 flex items-center gap-3">
            <div class="w-10 h-10 bg-gold/10 rounded-xl flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            Early Voting Locations
          </h3>

          <div class="space-y-4">
            <!-- Main Location -->
            <div class="bg-cream rounded-2xl p-6 border-2 border-gold/30 relative overflow-hidden hover-lift">
              <div class="absolute top-0 left-0 w-1 h-full bg-gradient-to-b from-gold to-gold-light"></div>
              <div class="pl-4">
                <div class="flex items-center gap-2 mb-2">
                  <span class="text-[10px] bg-gold text-white px-2 py-0.5 rounded font-sans font-bold uppercase tracking-wider">Main Location</span>
                </div>
                <h4 class="text-lg font-serif font-bold text-navy mb-1">Bastrop County Courthouse Annex</h4>
                <p class="text-near-black/60 font-sans text-sm">804 Pecan St., Lower Level, Conference Room</p>
                <p class="text-near-black/60 font-sans text-sm">Bastrop, TX 78602</p>
                <a 
                  href="https://www.google.com/maps/search/?api=1&query=804+Pecan+St+Bastrop+TX+78602"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center mt-3 text-gold font-sans font-bold text-xs uppercase tracking-wide hover:text-navy transition-colors"
                >
                  <svg class="w-3.5 h-3.5 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                  Get Directions
                </a>
              </div>
            </div>

            <!-- Branch Locations -->
            <div class="bg-white rounded-2xl p-6 border border-warm-gray hover-lift">
              <div class="flex items-center gap-2 mb-2">
                <span class="text-[10px] bg-navy/10 text-navy px-2 py-0.5 rounded font-sans font-bold uppercase tracking-wider">Branch</span>
              </div>
              <h4 class="text-lg font-serif font-bold text-navy mb-1">Smithville Recreation Center</h4>
              <p class="text-near-black/60 font-sans text-sm">106 Royston St., Smithville</p>
              <a 
                href="https://www.google.com/maps/search/?api=1&query=106+Royston+St+Smithville+TX"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center mt-3 text-gold font-sans font-bold text-xs uppercase tracking-wide hover:text-navy transition-colors"
              >
                <svg class="w-3.5 h-3.5 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
                Get Directions
              </a>
            </div>

            <div class="bg-white rounded-2xl p-6 border border-warm-gray hover-lift">
              <div class="flex items-center gap-2 mb-2">
                <span class="text-[10px] bg-navy/10 text-navy px-2 py-0.5 rounded font-sans font-bold uppercase tracking-wider">Branch</span>
              </div>
              <h4 class="text-lg font-serif font-bold text-navy mb-1">Bastrop County Cedar Creek Annex</h4>
              <p class="text-near-black/60 font-sans text-sm">5785 FM 535, Cedar Creek</p>
              <a 
                href="https://www.google.com/maps/search/?api=1&query=5785+FM+535+Cedar+Creek+TX"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center mt-3 text-gold font-sans font-bold text-xs uppercase tracking-wide hover:text-navy transition-colors"
              >
                <svg class="w-3.5 h-3.5 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
                Get Directions
              </a>
            </div>

            <div class="bg-white rounded-2xl p-6 border border-warm-gray hover-lift relative overflow-hidden">
              <div class="absolute top-0 left-0 w-1 h-full bg-gradient-to-b from-red to-red/50"></div>
              <div class="pl-4">
                <div class="flex items-center gap-2 mb-2">
                  <span class="text-[10px] bg-red/10 text-red px-2 py-0.5 rounded font-sans font-bold uppercase tracking-wider">Branch · Precinct 4</span>
                </div>
                <h4 class="text-lg font-serif font-bold text-navy mb-1">North Bastrop County Community Annex</h4>
                <p class="text-near-black/60 font-sans text-sm">702 Bull Run, Elgin</p>
                <a 
                  href="https://www.google.com/maps/search/?api=1&query=702+Bull+Run+Elgin+TX"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center mt-3 text-gold font-sans font-bold text-xs uppercase tracking-wide hover:text-navy transition-colors"
                >
                  <svg class="w-3.5 h-3.5 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                  Get Directions
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="section-divider"></div>

  <!-- Election Day Section -->
  <section id="election-day" class="py-16 sm:py-24 bg-cream scroll-mt-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16 reveal">
        <div class="gold-line mx-auto mb-6"></div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-navy mb-4">Election Day Locations</h2>
        <p class="text-xl text-slate font-sans font-light max-w-2xl mx-auto mb-2">
          Tuesday, November 3, 2026
        </p>
        <p class="text-lg font-sans font-semibold text-navy">
          Polls Open: <span class="text-gold">7:00 AM – 7:00 PM</span>
        </p>
        <p class="text-near-black/50 text-sm font-sans mt-2">
          Vote at <strong>any</strong> of the 15 countywide voting centers below.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 reveal-stagger">

        <!-- Location 1 -->
        <div class="bg-white rounded-xl p-5 border border-warm-gray hover-lift group">
          <div class="flex items-start gap-3">
            <span class="flex-shrink-0 w-8 h-8 bg-navy rounded-lg flex items-center justify-center text-white font-sans font-bold text-sm">1</span>
            <div class="min-w-0">
              <h4 class="font-serif font-bold text-navy text-sm leading-tight mb-1">Aqua Water Supply</h4>
              <p class="text-near-black/50 font-sans text-xs">401 Old Austin Hwy., Bastrop</p>
              <a href="https://www.google.com/maps/search/?api=1&query=401+Old+Austin+Hwy+Bastrop+TX" target="_blank" rel="noopener noreferrer" class="inline-flex items-center mt-2 text-gold font-sans font-bold text-[10px] uppercase tracking-wide hover:text-navy transition-colors opacity-0 group-hover:opacity-100">
                Directions →
              </a>
            </div>
          </div>
        </div>

        <!-- Location 2 -->
        <div class="bg-white rounded-xl p-5 border border-warm-gray hover-lift group">
          <div class="flex items-start gap-3">
            <span class="flex-shrink-0 w-8 h-8 bg-navy rounded-lg flex items-center justify-center text-white font-sans font-bold text-sm">2</span>
            <div class="min-w-0">
              <h4 class="font-serif font-bold text-navy text-sm leading-tight mb-1">River Valley Christian Fellowship</h4>
              <p class="text-near-black/50 font-sans text-xs">1224 W. Hwy 71, Bastrop</p>
              <a href="https://www.google.com/maps/search/?api=1&query=1224+W+Hwy+71+Bastrop+TX" target="_blank" rel="noopener noreferrer" class="inline-flex items-center mt-2 text-gold font-sans font-bold text-[10px] uppercase tracking-wide hover:text-navy transition-colors opacity-0 group-hover:opacity-100">
                Directions →
              </a>
            </div>
          </div>
        </div>

        <!-- Location 3 -->
        <div class="bg-white rounded-xl p-5 border border-warm-gray hover-lift group">
          <div class="flex items-start gap-3">
            <span class="flex-shrink-0 w-8 h-8 bg-navy rounded-lg flex items-center justify-center text-white font-sans font-bold text-sm">3</span>
            <div class="min-w-0">
              <h4 class="font-serif font-bold text-navy text-sm leading-tight mb-1">Bastrop County Courthouse Annex</h4>
              <p class="text-near-black/50 font-sans text-xs">804 Pecan St., Bastrop</p>
              <a href="https://www.google.com/maps/search/?api=1&query=804+Pecan+St+Bastrop+TX+78602" target="_blank" rel="noopener noreferrer" class="inline-flex items-center mt-2 text-gold font-sans font-bold text-[10px] uppercase tracking-wide hover:text-navy transition-colors opacity-0 group-hover:opacity-100">
                Directions →
              </a>
            </div>
          </div>
        </div>

        <!-- Location 4 -->
        <div class="bg-white rounded-xl p-5 border border-warm-gray hover-lift group">
          <div class="flex items-start gap-3">
            <span class="flex-shrink-0 w-8 h-8 bg-navy rounded-lg flex items-center justify-center text-white font-sans font-bold text-sm">4</span>
            <div class="min-w-0">
              <h4 class="font-serif font-bold text-navy text-sm leading-tight mb-1">Paige Community Center</h4>
              <p class="text-near-black/50 font-sans text-xs">107 S. Main St., Paige</p>
              <a href="https://www.google.com/maps/search/?api=1&query=107+S+Main+St+Paige+TX" target="_blank" rel="noopener noreferrer" class="inline-flex items-center mt-2 text-gold font-sans font-bold text-[10px] uppercase tracking-wide hover:text-navy transition-colors opacity-0 group-hover:opacity-100">
                Directions →
              </a>
            </div>
          </div>
        </div>

        <!-- Location 5 -->
        <div class="bg-white rounded-xl p-5 border border-warm-gray hover-lift group">
          <div class="flex items-start gap-3">
            <span class="flex-shrink-0 w-8 h-8 bg-navy rounded-lg flex items-center justify-center text-white font-sans font-bold text-sm">5</span>
            <div class="min-w-0">
              <h4 class="font-serif font-bold text-navy text-sm leading-tight mb-1">Bastrop County Community Center</h4>
              <p class="text-near-black/50 font-sans text-xs">15 American Legion Dr., Bastrop</p>
              <a href="https://www.google.com/maps/search/?api=1&query=15+American+Legion+Dr+Bastrop+TX" target="_blank" rel="noopener noreferrer" class="inline-flex items-center mt-2 text-gold font-sans font-bold text-[10px] uppercase tracking-wide hover:text-navy transition-colors opacity-0 group-hover:opacity-100">
                Directions →
              </a>
            </div>
          </div>
        </div>

        <!-- Location 6 -->
        <div class="bg-white rounded-xl p-5 border border-warm-gray hover-lift group">
          <div class="flex items-start gap-3">
            <span class="flex-shrink-0 w-8 h-8 bg-navy rounded-lg flex items-center justify-center text-white font-sans font-bold text-sm">6</span>
            <div class="min-w-0">
              <h4 class="font-serif font-bold text-navy text-sm leading-tight mb-1">Smithville Rec Center</h4>
              <p class="text-near-black/50 font-sans text-xs">106 Royston St., Smithville</p>
              <a href="https://www.google.com/maps/search/?api=1&query=106+Royston+St+Smithville+TX" target="_blank" rel="noopener noreferrer" class="inline-flex items-center mt-2 text-gold font-sans font-bold text-[10px] uppercase tracking-wide hover:text-navy transition-colors opacity-0 group-hover:opacity-100">
                Directions →
              </a>
