  <!-- Client-side Interactive Filter & Search Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('qa-search-input');
      const clearBtn = document.getElementById('qa-clear-search');
      const topicBtns = document.querySelectorAll('.topic-btn');
      const cards = document.querySelectorAll('.qa-card');
      const noResults = document.getElementById('no-results-msg');
      const resetSearchBtn = document.getElementById('reset-search-btn');

      let currentTopic = 'all';
      let currentQuery = '';

      function filterCards() {
        let visibleCount = 0;
        const q = currentQuery.toLowerCase().trim();

        cards.forEach(card => {
          const topics = (card.getAttribute('data-topics') || '').toLowerCase();
          const cardText = card.textContent.toLowerCase();

          const matchesTopic = (currentTopic === 'all') || topics.includes(currentTopic);
          const matchesQuery = !q || cardText.includes(q);

          if (matchesTopic && matchesQuery) {
            card.style.display = 'block';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (noResults) {
          if (visibleCount === 0) {
            noResults.classList.remove('hidden');
          } else {
            noResults.classList.add('hidden');
          }
        }

        if (clearBtn) {
          if (q.length > 0 || currentTopic !== 'all') {
            clearBtn.classList.remove('hidden');
          } else {
            clearBtn.classList.add('hidden');
          }
        }
      }

      // Search input listener
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          currentQuery = e.target.value;
          filterCards();
        });
      }

      // Topic button listeners
      topicBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          topicBtns.forEach(b => {
            b.classList.remove('active', 'bg-navy', 'text-white', 'shadow-sm');
            b.classList.add('bg-warm-gray', 'text-near-black/70');
          });

          btn.classList.add('active', 'bg-navy', 'text-white', 'shadow-sm');
          btn.classList.remove('bg-warm-gray', 'text-near-black/70');

          currentTopic = btn.getAttribute('data-topic') || 'all';
          filterCards();
        });
      });

      // Clear search button
      function resetFilters() {
        if (searchInput) searchInput.value = '';
        currentQuery = '';
        currentTopic = 'all';

        topicBtns.forEach(b => {
          if (b.getAttribute('data-topic') === 'all') {
            b.classList.add('active', 'bg-navy', 'text-white', 'shadow-sm');
            b.classList.remove('bg-warm-gray', 'text-near-black/70');
          } else {
            b.classList.remove('active', 'bg-navy', 'text-white', 'shadow-sm');
            b.classList.add('bg-warm-gray', 'text-near-black/70');
          }
        });

        filterCards();
      }

      if (clearBtn) clearBtn.addEventListener('click', resetFilters);
      if (resetSearchBtn) resetSearchBtn.addEventListener('click', resetFilters);
    });
  </script>
</Base>
