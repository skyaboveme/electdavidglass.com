---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" class={className}>
  <!-- Definitions for clip paths and text paths -->
  <defs>
    <!-- Clipping circle for the inner elements -->
    <clipPath id="inner-clip">
      <circle cx="256" cy="256" r="222" />
    </clipPath>
    
    <!-- Path for the curved ELECT text at the bottom -->
    <path id="text-path-bottom" d="M 101,390 A 205,205 0 0,0 411,390" />
  </defs>

  <!-- Outer thick navy circle -->
  <circle cx="256" cy="256" r="240" fill="none" stroke="#1b2a4a" stroke-width="12" />

  <!-- Thin navy circle inside the gap -->
  <circle cx="256" cy="256" r="224" fill="#ffffff" stroke="#1b2a4a" stroke-width="3" />

  <!-- Inner Content (Clipped to fit inside the thin navy circle) -->
  <g clip-path="url(#inner-clip)">
    <!-- Top Navy Segment -->
    <rect x="0" y="0" width="512" height="175" fill="#1b2a4a" />
    
    <!-- Bottom Red Segment -->
    <rect x="0" y="380" width="512" height="132" fill="#c41e3a" />

    <!-- White Circle Outline for Star Area -->
    <circle cx="256" cy="108" r="60" stroke="#ffffff" stroke-width="3" fill="none" opacity="0.9" />

    <!-- 3D Shaded Star -->
    <g id="star">
      <!-- Top Ray -->
      <polygon points="256,105 256,63 266.3,90.8" fill="#d5dee5" />
      <polygon points="256,105 245.7,90.8 256,63" fill="#ffffff" />
      
      <!-- Right-Top Ray -->
      <polygon points="256,105 296,92 272.6,110.4" fill="#d5dee5" />
      <polygon points="256,105 266.3,90.8 296,92" fill="#ffffff" />
      
      <!-- Right-Bottom Ray -->
      <polygon points="256,105 280.7,139 256,122.5" fill="#d5dee5" />
      <polygon points="256,105 272.6,110.4 280.7,139" fill="#ffffff" />
      
      <!-- Left-Bottom Ray -->
      <polygon points="256,105 231.3,139 239.4,110.4" fill="#ffffff" />
      <polygon points="256,105 256,122.5 231.3,139" fill="#d5dee5" />
      
      <!-- Left-Top Ray -->
      <polygon points="256,105 216,92 245.7,90.8" fill="#ffffff" />
      <polygon points="256,105 239.4,110.4 216,92" fill="#d5dee5" />
    </g>

    <!-- Red Swoosh with White Outline -->
    <path d="M 195,135 C 240,170 300,140 350,80 C 295,120 235,135 195,135 Z" 
          fill="#ffffff" stroke="#ffffff" stroke-width="6" stroke-linejoin="round" />
    <path d="M 195,135 C 240,170 300,140 350,80 C 295,120 235,135 195,135 Z" 
          fill="#c41e3a" />
  </g>

  <!-- Name Text in the Middle White Area -->
  <text x="256" y="246" 
        class="font-montserrat-black fill-navy"
        font-size="82" 
        text-anchor="middle" 
        letter-spacing="-2">DAVID</text>
        
  <text x="256" y="328" 
        class="font-montserrat-black fill-navy"
        font-size="82" 
        text-anchor="middle" 
        letter-spacing="-2">GLASS</text>

  <!-- Curved ELECT Text inside the Bottom Red Banner -->
  <text class="font-montserrat-extrabold fill-white"
        font-size="36" 
        letter-spacing="10">
    <textPath href="#text-path-bottom" startOffset="50%" text-anchor="middle">ELECT</textPath>
  </text>
</svg>
