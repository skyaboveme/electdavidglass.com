---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" class={className}>
  <!-- Definitions for clip paths and text paths -->
  <defs>
    <!-- Clipping circle for the inner elements -->
    <clipPath id="inner-clip">
      <circle cx="256" cy="256" r="222" />
    </clipPath>
    
    <!-- Path for the curved ELECT text at the bottom -->
    <path id="text-path-bottom" d="M 98,392 A 206,206 0 0,0 414,392" />
  </defs>

  <!-- Outer thick navy circle -->
  <circle cx="256" cy="256" r="240" fill="none" stroke="#1b2a4a" stroke-width="12" />

  <!-- Thin navy circle inside the gap -->
  <circle cx="256" cy="256" r="224" fill="#ffffff" stroke="#1b2a4a" stroke-width="3" />

  <!-- Inner Content (Clipped to fit inside the thin navy circle) -->
  <g clip-path="url(#inner-clip)">
    <!-- Top Navy Segment -->
    <rect x="0" y="0" width="512" height="175" fill="#1b2a4a" />
    
    <!-- Bottom Red Segment -->
    <rect x="0" y="380" width="512" height="132" fill="#c41e3a" />

    <!-- White Circle Outline for Star Area -->
    <circle cx="256" cy="104" r="64" stroke="#ffffff" stroke-width="3" fill="none" opacity="0.9" />

    <!-- 3D Shaded Star -->
    <g id="star">
      <!-- Top Ray -->
      <polygon points="256,104 256,58 267.2,88.6" fill="#d5dee5" />
      <polygon points="256,104 244.8,88.6 256,58" fill="#ffffff" />
      
      <!-- Right-Top Ray -->
      <polygon points="256,104 299.7,89.8 274.1,109.9" fill="#d5dee5" />
      <polygon points="256,104 267.2,88.6 299.7,89.8" fill="#ffffff" />
      
      <!-- Right-Bottom Ray -->
      <polygon points="256,104 283,141.2 256,123" fill="#d5dee5" />
      <polygon points="256,104 274.1,109.9 283,141.2" fill="#ffffff" />
      
      <!-- Left-Bottom Ray -->
      <polygon points="256,104 229,141.2 237.9,109.9" fill="#ffffff" />
      <polygon points="256,104 256,123 229,141.2" fill="#d5dee5" />
      
      <!-- Left-Top Ray -->
      <polygon points="256,104 212.3,89.8 244.8,88.6" fill="#ffffff" />
      <polygon points="256,104 237.9,109.9 212.3,89.8" fill="#d5dee5" />
    </g>

    <!-- Red Swoosh with White Outline -->
    <path d="M 190,135 C 238,172 302,142 355,80 C 298,122 232,135 190,135 Z" 
          fill="#ffffff" stroke="#ffffff" stroke-width="6" stroke-linejoin="round" />
    <path d="M 190,135 C 238,172 302,142 355,80 C 298,122 232,135 190,135 Z" 
          fill="#c41e3a" />
  </g>

  <!-- Name Text in the Middle White Area -->
  <text x="256" y="242" 
        class="font-montserrat-black fill-navy"
        font-size="94" 
        text-anchor="middle" 
        letter-spacing="-3">DAVID</text>
        
  <text x="256" y="326" 
        class="font-montserrat-black fill-navy"
        font-size="94" 
        text-anchor="middle" 
        letter-spacing="-3">GLASS</text>

  <!-- Curved ELECT Text inside the Bottom Red Banner -->
  <text class="font-montserrat-black fill-white"
        font-size="44" 
        letter-spacing="10">
    <textPath href="#text-path-bottom" startOffset="50%" text-anchor="middle">ELECT</textPath>
  </text>
</svg>
