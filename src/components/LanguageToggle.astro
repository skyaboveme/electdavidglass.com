---
/**
 * Language toggle component: EN/ES pill switch
 * Renders in navigation bar (desktop + mobile)
 */
---

<button
  type="button"
  id="lang-toggle"
  class="lang-toggle"
  aria-label="Switch language / Cambiar idioma"
  title="Switch language / Cambiar idioma"
>
  <span class="lang-option" data-lang="en" id="lang-en">
    <span class="lang-flag">🇺🇸</span>EN
  </span>
  <span class="lang-divider">|</span>
  <span class="lang-option" data-lang="es" id="lang-es">
    <span class="lang-flag">🇲🇽</span>ES
  </span>
</button>
